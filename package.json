{
  "name": "cpeople",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cpeople/db run generate",
    "db:migrate": "pnpm --filter @cpeople/db run migrate",
    "db:deploy": "pnpm --filter @cpeople/db run migrate:deploy",
    "db:reset": "pnpm --filter @cpeople/db run migrate:reset",
    "db:seed": "pnpm --filter @cpeople/db run seed",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
