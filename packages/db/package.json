{
  "name": "@cpeople/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, row-level-security policies and seed for CPeople",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate": "cross-env CPEOPLE_LOCAL_DEV=true prisma migrate dev",
    "migrate:deploy": "cross-env CPEOPLE_LOCAL_DEV=true prisma migrate deploy",
    "migrate:reset": "cross-env CPEOPLE_LOCAL_DEV=true prisma migrate reset",
    "seed": "pnpm run build && cross-env CPEOPLE_LOCAL_DEV=true node dist/seed.js",
    "test": "prisma generate && cross-env CPEOPLE_LOCAL_DEV=true vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
