// CPeople database schema.
//
// Rules that apply to every model here (CLAUDE.md):
//  1. Every business table carries tenant_id and is protected by a row-level-security
//     policy. See the migration 0002_row_level_security and test/rls.spec.ts.
//  2. Nothing country-specific in the core: Moroccan identifiers (CIN, CNSS, CIMR...)
//     belong to packages/country-packs/ma, never to a core table.
//  4. Money is stored in integer minor units with its currency, never as a float.
//  6. Salary, CIN and RIB are encrypted at field level.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // ESM with .js specifiers: NestJS 12 and Prisma 7 are both ESM-only, and tsc
  // resolves "./x.js" to the generated "./x.ts" source when it compiles the package.
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// A customer of CPeople (M01 / HR-08). The root of tenant isolation: every other
/// table points at it through tenant_id.
model Tenant {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Short stable key used in URLs and configuration, e.g. "smg".
  slug        String   @unique
  name        String
  /// ISO 3166-1 alpha-2. Selects the country pack (M24), e.g. "MA".
  countryCode String   @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies            Company[]
  sites                Site[]
  costCentres          CostCentre[]
  departments          Department[]
  positions            Position[]
  employees            Employee[]
  dependents           Dependent[]
  contractTypes        ContractType[]
  contractTemplates    ContractTemplate[]
  contractClauses      ContractClause[]
  contracts            Contract[]
  documentTypes        DocumentType[]
  documents            EmployeeDocument[]
  checklistTemplates   ChecklistTemplate[]
  checklistItems       ChecklistItemTemplate[]
  onboardingTasks      OnboardingTask[]
  auditEvents          AuditEvent[]
  publicHolidays       PublicHoliday[]
  leaveTypes           LeaveType[]
  leaveRules           LeaveRule[]
  siteWorkWeeks        SiteWorkWeek[]
  leaveSettings        LeaveSettings?
  leaveRequests        LeaveRequest[]
  leaveCalculations    LeaveCalculation[]
  leaveDecisions       LeaveDecision[]
  publicHolidayYears   PublicHolidayYear[]
  payrollPeriods       PayrollPeriod[]
  leaveCorrections     LeaveCorrection[]
  openingBalances      LeaveOpeningBalance[]
  balanceAdjustments   LeaveBalanceAdjustment[]
  carryOvers           LeaveCarryOver[]
  carryOverRuns        LeaveCarryOverRun[]
  settings             TenantSettings?
  shiftPatterns        ShiftPattern[]
  workSchedules        WorkSchedule[]
  workScheduleDays     WorkScheduleDay[]
  employeeSchedules    EmployeeSchedule[]
  shiftAssignments     ShiftAssignment[]
  attendanceSources    AttendanceSource[]
  attendanceImports    AttendanceImport[]
  punches              Punch[]
  employeeAliases      EmployeeNumberAlias[]
  workDays             WorkDay[]
  attendanceExceptions AttendanceException[]
  overtimeRules        OvertimeRule[]
  overtimeSettings     OvertimeSettings?

  @@map("tenant")
}

/// A legal entity inside a tenant (M01 / IMP-01). Country-neutral by design:
/// the Moroccan employer identifiers hang off the MA country pack, not off this table.
model Company {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  legalName       String   @map("legal_name")
  /// ISO 4217. Stored with the company so every amount it owns carries a currency.
  defaultCurrency String   @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sites       Site[]
  costCentres CostCentre[]
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("company")
}

// ---------------------------------------------------------------------------
// The employee file: people, where they sit, what they signed, what they owe us
// (M03-M07 / HR-01).
//
// Country-neutral on purpose (rule 2). Morocco calls the national identifier a
// CIN, the social-security number a CNSS number and the complementary pension
// CIMR; those are names, and they belong to the MA country pack together with
// their formats and their validation. What the core stores is the neutral field.
//
// TODO(M21): salary, national id and bank account are the fields rule 6 wants
// encrypted at field level. That encryption is not built yet, so the HR-01 demo
// does not claim it, and until it is this data is invented only.
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  onboarding
  active
  left

  @@map("employee_status")
}

enum Gender {
  female
  male
  unspecified

  @@map("gender")
}

enum MaritalStatus {
  single
  married
  divorced
  widowed

  @@map("marital_status")
}

enum ContractStatus {
  draft
  generated
  signed
  renewed
  ended

  @@map("contract_status")
}

enum OnboardingTaskStatus {
  todo
  done

  @@map("onboarding_task_status")
}

/// A place of work (M01 / IMP-01): the outlet, the kitchen, the head office.
model Site {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  city      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  employees   Employee[]
  contracts   Contract[]
  workWeeks   SiteWorkWeek[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("site")
}

/// Where a cost lands in the ledger (M01 / HR-07). `sapCostCentre` is the code in
/// S/4HANA, left empty until Finance maps it (workshop HR-03).
model CostCentre {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  code          String
  name          String
  sapCostCentre String?  @map("sap_cost_centre")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cost_centre")
}

/// A department (M01). Its cost centre is the default for everyone in it; an
/// employee may override that, and the override is kept as such.
model Department {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  code           String
  name           String
  siteId         String?  @map("site_id") @db.Uuid
  costCentreId   String?  @map("cost_centre_id") @db.Uuid
  headEmployeeId String?  @map("head_employee_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site       Site?       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  costCentre CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  head       Employee?   @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  positions  Position[]
  employees  Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("department")
}

/// A job, not a person (M01 / M06). The line between positions is what the
/// organisation chart falls back on when a post is vacant.
model Position {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  code                String
  title               String
  departmentId        String   @map("department_id") @db.Uuid
  reportsToPositionId String?  @map("reports_to_position_id") @db.Uuid
  plannedHeadcount    Int?     @map("planned_headcount")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reportsTo  Position?  @relation("PositionLine", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  reports    Position[] @relation("PositionLine")
  employees  Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("position")
}

/// A person on the payroll (M03 / HR-01).
model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  /// The employer's own number for this person, e.g. SMG-0001.
  employeeNumber String         @map("employee_number")
  status         EmployeeStatus @default(onboarding)

  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  gender          Gender        @default(unspecified)
  birthDate       DateTime      @map("birth_date") @db.Date
  nationality     String        @db.Char(2)
  /// National identity document. Morocco: the CIN; the MA pack owns the format.
  nationalId      String        @map("national_id")
  maritalStatus   MaritalStatus @default(single) @map("marital_status")
  address         String?
  phone           String?
  email           String?
  /// Which language this person is written to in (M09 / HR-04). Morocco's HR
  /// paperwork is French, so that is the default; the sign-in account carries the
  /// same preference for the screens.
  preferredLocale String        @default("fr") @map("preferred_locale") @db.VarChar(5)

  positionId         String    @map("position_id") @db.Uuid
  departmentId       String    @map("department_id") @db.Uuid
  siteId             String?   @map("site_id") @db.Uuid
  costCentreId       String?   @map("cost_centre_id") @db.Uuid
  /// True when this person's cost centre is not their department's.
  costCentreOverride Boolean   @default(false) @map("cost_centre_override")
  managerId          String?   @map("manager_id") @db.Uuid
  hireDate           DateTime  @map("hire_date") @db.Date
  seniorityDate      DateTime  @map("seniority_date") @db.Date
  leftOn             DateTime? @map("left_on") @db.Date

  /// Integer minor units with its currency (rule 4): 650000 is 6 500,00 MAD.
  baseSalaryMinor      Int     @map("base_salary_minor")
  salaryCurrency       String  @default("MAD") @map("salary_currency") @db.Char(3)
  /// Social-security number. Morocco: the CNSS number.
  socialSecurityNumber String? @map("social_security_number")
  /// Member of the complementary pension scheme. Morocco: CIMR.
  pensionMember        Boolean @default(false) @map("pension_member")
  bankName             String? @map("bank_name")
  /// Bank account. Morocco: the RIB, 24 digits.
  bankAccount          String? @map("bank_account")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  position   Position    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  site       Site?       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  costCentre CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  manager    Employee?   @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)

  reports                 Employee[]               @relation("ReportsTo")
  leaveRequests           LeaveRequest[]           @relation("LeaveRequests")
  heads                   Department[]             @relation("DepartmentHead")
  dependents              Dependent[]
  contracts               Contract[]
  documents               EmployeeDocument[]
  tasks                   OnboardingTask[]
  leaveCorrections        LeaveCorrection[]
  leaveOpeningBalances    LeaveOpeningBalance[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]
  leaveCarryOvers         LeaveCarryOver[]
  employeeSchedules       EmployeeSchedule[]
  shiftAssignments        ShiftAssignment[]
  punches                 Punch[]
  employeeNumberAlias     EmployeeNumberAlias[]
  workDays                WorkDay[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, lastName])
  @@index([tenantId, departmentId])
  @@index([tenantId, managerId])
  @@map("employee")
}

/// A spouse or a child, which Moroccan income tax takes account of.
model Dependent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  relation   String
  firstName  String   @map("first_name")
  birthDate  DateTime @map("birth_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("dependent")
}

/// A kind of contract (M07 / HR-02). Morocco uses CDI, CDD and ANAPEC.
model ContractType {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  name             String
  requiresEndDate  Boolean  @default(false) @map("requires_end_date")
  defaultTrialDays Int?     @map("default_trial_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  templates ContractTemplate[]
  contracts Contract[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("contract_type")
}

/// The wording a contract is generated from. Sample text until SMG approves it.
model ContractTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  contractTypeId String   @map("contract_type_id") @db.Uuid
  language       String   @db.Char(2)
  version        Int      @default(1)
  title          String
  /// The body, with the {{merge.fields}} the generator fills in.
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contractType ContractType     @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  clauses      ContractClause[]
  contracts    Contract[]

  @@unique([tenantId, contractTypeId, language, version])
  @@index([tenantId])
  @@map("contract_template")
}

/// One article of a contract. Optional clauses can be left out when generating.
model ContractClause {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  key        String
  title      String
  text       String
  mandatory  Boolean  @default(true)
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, templateId, key])
  @@index([tenantId])
  @@map("contract_clause")
}

/// What this person actually signed (M07 / HR-02). A renewal points back at the
/// contract it follows, so the history of a fixed term reads end to end.
model Contract {
  id                 String         @id @default(uuid(7)) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  employeeId         String         @map("employee_id") @db.Uuid
  contractTypeId     String         @map("contract_type_id") @db.Uuid
  templateId         String?        @map("template_id") @db.Uuid
  status             ContractStatus @default(draft)
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime?      @map("end_date") @db.Date
  trialEndDate       DateTime?      @map("trial_end_date") @db.Date
  positionId         String?        @map("position_id") @db.Uuid
  workplaceSiteId    String?        @map("workplace_site_id") @db.Uuid
  salaryMinor        Int            @map("salary_minor")
  salaryCurrency     String         @default("MAD") @map("salary_currency") @db.Char(3)
  previousContractId String?        @unique @map("previous_contract_id") @db.Uuid
  endReason          String?        @map("end_reason")
  generatedAt        DateTime?      @map("generated_at") @db.Timestamptz(3)
  signedAt           DateTime?      @map("signed_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType ContractType       @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  template     ContractTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  site         Site?              @relation(fields: [workplaceSiteId], references: [id], onDelete: SetNull)
  previous     Contract?          @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewal      Contract?          @relation("ContractRenewal")
  documents    EmployeeDocument[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, endDate])
  @@map("contract")
}

/// A kind of document the employer keeps, and how long before it expires anyone
/// needs to know (M04 / HR-01).
model DocumentType {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  requiresExpiry  Boolean  @default(false) @map("requires_expiry")
  alertDaysBefore Int      @default(30) @map("alert_days_before")
  sensitive       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents EmployeeDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("document_type")
}

/// A file in someone's employee file. The bytes live in object storage; this row
/// is what the application reads, so a listing never touches the file itself.
model EmployeeDocument {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  documentTypeId String    @map("document_type_id") @db.Uuid
  contractId     String?   @map("contract_id") @db.Uuid
  fileName       String    @map("file_name")
  mimeType       String    @map("mime_type")
  byteSize       Int       @map("byte_size")
  /// Key in object storage. Empty on seeded rows: nothing was ever uploaded.
  storageKey     String?   @map("storage_key")
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  uploadedBy     String?   @map("uploaded_by")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  contract     Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, expiryDate])
  @@map("employee_document")
}

/// The checklist a new hire goes through (M05 / HR-01).
model ChecklistTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  ChecklistItemTemplate[]
  tasks  OnboardingTask[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("checklist_template")
}

model ChecklistItemTemplate {
  id                     String   @id @default(uuid(7)) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  templateId             String   @map("template_id") @db.Uuid
  title                  String
  /// Who does it: one of the CPeople roles (admin, hr, manager, employee).
  ownerRole              String   @map("owner_role")
  /// Days from the hire date; negative means before the person starts.
  dueOffsetDays          Int      @map("due_offset_days")
  requiresDocumentTypeId String?  @map("requires_document_type_id") @db.Uuid
  /// Department codes this item applies to; empty means all of them.
  departmentCodes        String[] @map("department_codes")
  mandatory              Boolean  @default(true)
  sortOrder              Int      @map("sort_order")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    OnboardingTask[]

  @@index([tenantId])
  @@map("checklist_item_template")
}

model OnboardingTask {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  employeeId     String               @map("employee_id") @db.Uuid
  templateId     String?              @map("template_id") @db.Uuid
  itemTemplateId String?              @map("item_template_id") @db.Uuid
  title          String
  ownerRole      String               @map("owner_role")
  dueDate        DateTime             @map("due_date") @db.Date
  status         OnboardingTaskStatus @default(todo)
  mandatory      Boolean              @default(true)
  doneAt         DateTime?            @map("done_at") @db.Timestamptz(3)
  doneBy         String?              @map("done_by")
  documentId     String?              @map("document_id") @db.Uuid
  sortOrder      Int                  @map("sort_order")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     ChecklistTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  itemTemplate ChecklistItemTemplate? @relation(fields: [itemTemplateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("onboarding_task")
}

/// Who did what, and what changed (M21 / HR-08). Written for every change, and
/// read on the employee file's History tab and on the audit screen.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz(3)
  /// The signed-in person, by their Keycloak subject, with the role they acted in.
  actorId   String?  @map("actor_id")
  actorName String?  @map("actor_name")
  actorRole String?  @map("actor_role")
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  summary   String
  /// Field-level before and after, as a list of { field, from, to }.
  diff      Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, at])
  @@index([tenantId, entity, entityId])
  @@map("audit_event")
}

/// A public holiday, from the country pack (M08 / M24). Kept per tenant because
/// a company adds its own closure days to the national list.
model PublicHoliday {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  date        DateTime @db.Date
  name        String
  /// Several Moroccan holidays move with the lunar calendar, so dates are entered
  /// and never calculated. Until the client confirms a year's list, every row in
  /// it says so on screen.
  confirmed   Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, countryCode, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("public_holiday")
}

/// How a leave type counts its days (M08 / HR-04).
enum LeaveDayBasis {
  /// Only the days this person would otherwise have worked.
  working
  /// Every day between the two dates, weekends and holidays included.
  calendar

  @@map("leave_day_basis")
}

/// A kind of absence (M08 / HR-04).
///
/// The seven seeded here are the ones SMG named; an administrator may add more.
/// What each one *is* — paid or not, counted in working or calendar days, needing
/// a document, needing a second approval — is data, because every one of those is
/// a question for the client rather than a fact about the world.
model LeaveType {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  /// ANNUAL, SICK, UNPAID, MATERNITY, PATERNITY, EXCEPTIONAL, OTHER, or a code the
  /// client adds. The screens translate the ones they know and fall back to `name`.
  code     String
  name     String
  paid     Boolean @default(true)

  /// Whether a request of this kind is expected to carry a certificate.
  requiresDocument       Boolean       @default(false) @map("requires_document")
  dayBasis               LeaveDayBasis @default(working) @map("day_basis")
  allowsHalfDays         Boolean       @default(true) @map("allows_half_days")
  /// Whether the manager's manager approves it as well (HR-02 open point 2).
  requiresSecondApproval Boolean       @default(false) @map("requires_second_approval")
  /// Whether it draws on a balance at all. Unpaid leave does not.
  tracksBalance          Boolean       @default(true) @map("tracks_balance")
  active                 Boolean       @default(true)
  sortOrder              Int           @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rules              LeaveRule[]
  requests           LeaveRequest[]
  corrections        LeaveCorrection[]
  openingBalances    LeaveOpeningBalance[]
  balanceAdjustments LeaveBalanceAdjustment[]
  carryOvers         LeaveCarryOver[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_type")
}

/// What a leave type is worth, from a date (M08 / HR-04, CLAUDE.md rule 3).
///
/// Effective-dated rows, like every other parameter in this product: a change for
/// 2027 leaves 2026 alone, so last year's balances can still be explained. Not one
/// of these numbers is written into the code, and every seeded row says it is a
/// demo value waiting for the payroll expert.
model LeaveRule {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  leaveTypeId   String    @map("leave_type_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Open-ended until a later row supersedes it.
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// Days a full year gives. Null where the type has no entitlement of its own.
  entitlementDays       Decimal?      @map("entitlement_days") @db.Decimal(5, 2)
  /// Days earned per month worked, where the right is earned rather than granted.
  accrualPerMonth       Decimal?      @map("accrual_per_month") @db.Decimal(5, 2)
  /// The most that may be carried into the next leave year, where the mode is
  /// `limited`.
  carryOverMaxDays      Decimal?      @map("carry_over_max_days") @db.Decimal(5, 2)
  /// What happens to days left at the end of the year: all of them carry, some
  /// of them carry, or they are lost. A demo value until SMG says otherwise.
  carryOverMode         CarryOverMode @default(limited) @map("carry_over_mode")
  /// How long carried days last into the new year, in months. Null means they
  /// do not expire.
  carryOverExpiryMonths Int?          @map("carry_over_expiry_months")

  /// How many months of service before the right may be taken at all. Days are
  /// still earned in the meantime; they simply cannot be used yet
  /// (HR-02 build spec §4.1, a demo value to confirm).
  usableAfterMonths        Int?     @map("usable_after_months")
  /// Extra days for long service, and how many completed years earn them.
  seniorityBonusDays       Decimal? @map("seniority_bonus_days") @db.Decimal(5, 2)
  seniorityBonusEveryYears Int?     @map("seniority_bonus_every_years")
  /// The most this right may ever reach in a year, bonus included.
  capDays                  Decimal? @map("cap_days") @db.Decimal(5, 2)
  /// Days of notice expected before the first day off. A warning, not a refusal.
  minNoticeDays            Int      @default(0) @map("min_notice_days")
  /// How far back a request of this kind may be dated.
  maxBackdateDays          Int      @default(0) @map("max_backdate_days")

  /// Why this row says what it says: the agreement, the law, or nobody yet.
  note      String?
  /// False until the client and the payroll expert have said yes.
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, leaveTypeId, effectiveFrom])
  @@map("leave_rule")
}

/// Which days a site works (M08 / HR-04).
///
/// The outlets trade at the weekend and the head office does not, so "how many
/// days is Monday to Sunday" has no single answer. Effective-dated, because a
/// trading pattern changes and last year's leave still has to add up.
model SiteWorkWeek {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  siteId      String @map("site_id") @db.Uuid
  /// Days worked, 0 for Sunday through 6 for Saturday — what `getUTCDay()` answers.
  workingDays Int[]  @map("working_days")

  effectiveFrom DateTime @map("effective_from") @db.Date
  note          String?
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, siteId, effectiveFrom])
  @@index([tenantId])
  @@map("site_work_week")
}

/// The company's own leave settings, one row per tenant (M08 / HR-04).
///
/// Only what is a company-wide decision rather than a property of a leave type.
model LeaveSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Warn when more than this share of a department is off on the same day. A
  /// warning shown to the requester and the approver; it refuses nothing
  /// (HR-02 open point 6).
  teamOffWarningPercent Int     @default(33) @map("team_off_warning_percent")
  /// The day the leave year starts, as MM-DD. Not a date: it repeats.
  leaveYearStart        String  @default("01-01") @map("leave_year_start")
  /// Where a request with nobody to approve it is sent. A team address rather
  /// than a person, so that it survives somebody leaving (HR-02 open point 11).
  hrEmail               String? @map("hr_email")
  /// How often leave is earned: "monthly", "quarterly" or "annual". A setting
  /// rather than a constant, because it is a question for SMG and because the
  /// answer changes every balance in the company.
  accrualPeriod         String  @default("monthly") @map("accrual_period")

  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("leave_settings")
}

// ---------------------------------------------------------------------------
// Leave requests, their approval, and the arithmetic behind them (M09 / HR-04).
//
// The rule this part of the schema exists to keep: **an approved request is
// never quietly recalculated.** What a request costs is worked out when it is
// sent and again when it is approved, and each answer is stored with the rule
// row, the working week and the public holidays that produced it. If one of
// those changes afterwards the stored answer stays, the difference is shown to
// HR, and somebody accepts it. Nobody's balance moves because a setting was
// edited on a Tuesday.
// ---------------------------------------------------------------------------

/// Where a request has got to (HR-02 spec 2).
enum LeaveRequestStatus {
  /// With the manager.
  pending_n1
  /// With the manager's manager, for the types that need a second yes.
  pending_n2
  /// With HR, because there is no manager to ask, or the manager is the requester.
  pending_hr
  approved
  rejected
  /// Taken back by the requester before anybody decided.
  withdrawn
  /// Approved, and the requester has asked to cancel it. Cancelling needs a yes too.
  cancellation_pending
  cancelled

  @@map("leave_request_status")
}

/// Which part of a day is taken. A single day may be a morning or an afternoon.
enum LeaveDayPart {
  full
  morning
  afternoon

  @@map("leave_day_part")
}

/// Why a calculation was made, which is also the order they happen in.
enum LeaveCalculationKind {
  /// When the request was sent.
  submitted
  /// When it was approved. This is the one a balance moves by.
  approved
  /// A setting changed while the request was still pending, so it was redone.
  recalculated
  /// A setting changed after approval and HR accepted the difference.
  accepted

  @@map("leave_calculation_kind")
}

/// What somebody did to a request, in their own words where there are any.
enum LeaveDecisionKind {
  submitted
  approved_n1
  approved_n2
  rejected
  withdrawn
  cancellation_requested
  cancellation_approved
  cancellation_rejected
  /// HR deciding in place of the line manager, which always carries a reason.
  hr_override
  recalculated
  change_accepted

  @@map("leave_decision_kind")
}

/// One request for time off (M09 / HR-04).
model LeaveRequest {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  employeeId  String             @map("employee_id") @db.Uuid
  leaveTypeId String             @map("leave_type_id") @db.Uuid
  status      LeaveRequestStatus @default(pending_n1)

  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  startPart LeaveDayPart @default(full) @map("start_part")
  endPart   LeaveDayPart @default(full) @map("end_part")

  /// The requester's own words. Private: it never goes in an e-mail, because a
  /// reason for sick leave is a medical detail (HR-02 spec 2).
  reason String?

  /// What it costs, as last agreed. The calculation rows below say how, and this
  /// never moves without one of them being written.
  dayCount Decimal @map("day_count") @db.Decimal(5, 2)

  /// The approvers, resolved from the organisation when the request was sent, so
  /// that a later reorganisation does not change who was asked.
  n1Id String? @map("n1_id") @db.Uuid
  n2Id String? @map("n2_id") @db.Uuid
  /// True when there was nobody to ask and HR was asked instead.
  toHr Boolean @default(false) @map("to_hr")

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(3)

  /// Set when a setting changed under a request that was still pending and it was
  /// redone. The requester and the approver are told, on the request itself.
  recalculatedAt DateTime? @map("recalculated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee           @relation("LeaveRequests", fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  calculations LeaveCalculation[]
  decisions    LeaveDecision[]
  corrections  LeaveCorrection[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@map("leave_request")
}

/// What a request cost, and everything that decided it (HR-02 spec, point 1).
///
/// Insert-only in spirit and in use: a new answer is a new row. Keeping the rule
/// row, the working week and the exact holidays means a count can be explained a
/// year later, and that a changed setting is detected rather than guessed.
model LeaveCalculation {
  id        String               @id @default(uuid(7)) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  requestId String               @map("request_id") @db.Uuid
  kind      LeaveCalculationKind

  dayCount Decimal @map("day_count") @db.Decimal(5, 2)
  /// Every day of the span and what it was worth, half-day markers included:
  /// [{ date, part, days, reason }].
  days     Json

  /// The versions that were applied.
  leaveRuleId      String?       @map("leave_rule_id") @db.Uuid
  workWeekId       String?       @map("work_week_id") @db.Uuid
  holidayIds       String[]      @map("holiday_ids") @db.Uuid
  workingDays      Int[]         @map("working_days")
  dayBasis         LeaveDayBasis @map("day_basis")
  /// Whether the holidays of every year the request touches were marked complete
  /// at the time. False means the count may still move.
  holidaysComplete Boolean       @default(false) @map("holidays_complete")

  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, requestId])
  @@map("leave_calculation")
}

/// Who did what to a request, in order (M09 / HR-04).
///
/// The audit log keeps the same facts for the whole system; this is the story
/// the request's own screen tells, to the people the request belongs to.
model LeaveDecision {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  requestId String            @map("request_id") @db.Uuid
  kind      LeaveDecisionKind

  /// The employee file of whoever did it, where they have one.
  byEmployeeId String? @map("by_employee_id") @db.Uuid
  byName       String  @map("by_name")
  byRole       String  @map("by_role")
  /// Required of an HR override, optional elsewhere.
  reason       String?

  at DateTime @default(now()) @db.Timestamptz(3)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, requestId])
  @@map("leave_decision")
}

/// Whether a year's public holidays are finished (HR-02 spec, point 3).
///
/// The moveable religious holidays are announced each year, so a year's list is
/// incomplete until an administrator says it is not. Until then every request
/// falling in that year warns the requester, the approver and HR that the count
/// may still move.
model PublicHolidayYear {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  countryCode String  @map("country_code") @db.Char(2)
  year        Int
  complete    Boolean @default(false)

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  completedBy String?   @map("completed_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, countryCode, year])
  @@index([tenantId])
  @@map("public_holiday_year")
}

// ---------------------------------------------------------------------------
// Balances, and the payroll month they eventually land in (M09 / M10, HR-04).
//
// The rule that shapes all of it: **a balance is never a number somebody typed.**
// It is worked out, every time it is asked for, from rows that each say where
// they came from — an opening balance imported with a date, the days a rule
// accrues, what has actually been taken, what is waiting for a decision, and
// HR's adjustments, each of which carries a reason and cannot be edited after
// the fact. That is what makes a balance explicable a year later, and what
// stops it quietly disagreeing with payroll.
// ---------------------------------------------------------------------------

/// Whether a payroll month may still change (HR-02 open point 13).
///
/// Placed here, now, because leave needs to know: a change to leave that falls
/// in a locked month must not reach back into it. HR-03 takes this table over
/// and gives it the rest of what a payroll period is.
enum PayrollPeriodStatus {
  open
  locked

  @@map("payroll_period_status")
}

model PayrollPeriod {
  id       String              @id @default(uuid(7)) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  /// The month itself, as "2026-11". A month, not a date: it has no day.
  month    String
  status   PayrollPeriodStatus @default(open)

  lockedAt DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy String?   @map("locked_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  corrections LeaveCorrection[]

  @@unique([tenantId, month])
  @@index([tenantId])
  @@map("payroll_period")
}

/// A leave change that belongs to a month nobody may edit any more.
///
/// A closed payroll month is never reopened (CLAUDE.md rule 5). When a change
/// to leave falls in one, the difference is written down here and carried to the
/// next open month, where payroll will read it. Nothing is corrected in place
/// and nothing is lost.
///
/// **Default, to be confirmed by the payroll expert** (HR-02 open point 13).
model LeaveCorrection {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  requestId   String @map("request_id") @db.Uuid
  leaveTypeId String @map("leave_type_id") @db.Uuid

  /// The month the change belonged to, which is closed.
  originalMonth   String @map("original_month")
  /// The open month it is carried to, where payroll will pick it up.
  appliedPeriodId String @map("applied_period_id") @db.Uuid

  /// Signed: positive where the employee took more than was counted.
  dayDifference Decimal @map("day_difference") @db.Decimal(5, 2)
  /// Whether these are paid days, which decides what payroll does with them.
  paid          Boolean

  /// Why, in words, always. Never blank.
  reason String

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by")
  createdRole String   @map("created_role")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  request       LeaveRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  leaveType     LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  appliedPeriod PayrollPeriod @relation(fields: [appliedPeriodId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, appliedPeriodId])
  @@index([tenantId, employeeId])
  @@map("leave_correction")
}

/// What somebody had on the day their history with us starts (M09 / HR-04).
///
/// Imported, with the date it is a balance *at*: a company moving to CPeople in
/// February brings a balance as at 31 January, and everything after that is
/// accrued and taken here. Without the date the number means nothing.
model LeaveOpeningBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  days        Decimal  @db.Decimal(6, 2)
  /// The day this balance is true as at.
  balanceAt   DateTime @map("balance_at") @db.Date

  /// Which import put it here, so a bad file can be found again.
  importId String? @map("import_id") @db.Uuid
  note     String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by")
  createdRole String   @map("created_role")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, leaveTypeId, balanceAt])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_opening_balance")
}

/// HR moving a balance by hand, with a reason (M09 / HR-04).
///
/// Insert-only, like the audit log and for the same reason: an adjustment that
/// could be edited away is not a record of anything. Correcting one is another
/// adjustment in the other direction, and both stay in the history.
model LeaveBalanceAdjustment {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  leaveTypeId String  @map("leave_type_id") @db.Uuid
  /// Signed: days given or days taken away.
  days        Decimal @db.Decimal(6, 2)
  /// Mandatory, and shown wherever the adjustment is shown.
  reason      String

  /// The day it counts from, which decides the leave year it lands in.
  effectiveOn DateTime @map("effective_on") @db.Date

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by")
  createdRole String   @map("created_role")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_balance_adjustment")
}

/// What a leave type does with days left over at the end of the year.
enum CarryOverMode {
  /// Everything left goes into the new year.
  all
  /// Up to `carryOverMaxDays`, and no more.
  limited
  /// Nothing. What is not taken is lost.
  none

  @@map("carry_over_mode")
}

/// One year's carry-over for one person and one type (M09 / HR-04).
///
/// Written by the year-end run, one row per person per type per year, which is
/// what lets the run be repeated safely: a second pass finds the row already
/// there and replaces its figure rather than adding to it.
model LeaveCarryOver {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  /// The year the days were earned in, and the one they move into.
  fromYear    Int       @map("from_year")
  toYear      Int       @map("to_year")
  /// What was left before the rule was applied, and what survived it.
  leftOver    Decimal   @map("left_over") @db.Decimal(6, 2)
  days        Decimal   @db.Decimal(6, 2)
  /// After this day the carried days are gone. Null where they do not expire.
  expiresOn   DateTime? @map("expires_on") @db.Date

  runId     String   @map("run_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  run       LeaveCarryOverRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveTypeId, fromYear])
  @@index([tenantId])
  @@index([tenantId, toYear])
  @@map("leave_carry_over")
}

enum CarryOverRunStatus {
  /// Worked out and shown, and nothing written to anybody's balance.
  preview
  applied

  @@map("carry_over_run_status")
}

/// One year-end run, previewed or applied (M09 / HR-04).
model LeaveCarryOverRun {
  id       String             @id @default(uuid(7)) @db.Uuid
  tenantId String             @map("tenant_id") @db.Uuid
  /// The year being closed.
  fromYear Int                @map("from_year")
  status   CarryOverRunStatus @default(preview)

  /// What it did, for the screen that reports it.
  employees Int     @default(0)
  carried   Decimal @default(0) @db.Decimal(10, 2)
  lost      Decimal @default(0) @db.Decimal(10, 2)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  byName     String    @map("by_name")
  byRole     String    @map("by_role")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  carryOvers LeaveCarryOver[]

  @@index([tenantId])
  @@index([tenantId, fromYear])
  @@map("leave_carry_over_run")
}

/// The company's own settings, outside leave (HR-02 build spec §1 and §7.1).
///
/// One row per tenant. Every field here is a decision SMG takes and changes
/// themselves, which is why none of them is a constant in the code.
model TenantSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// What an employee number must look like. Decision 2 of the HR-01 minutes
  /// makes it the biometric device id, and the format is still open (open
  /// point 4), so this is a **warning only**: a number that does not match is
  /// flagged and still accepted.
  employeeNumberPattern String @default("^\\d{1,10}$") @map("employee_number_pattern")

  /// Whether an employee may see their own base salary (HR-01 open point 2).
  /// When off, the API does not send it — it is not merely hidden on screen.
  employeesSeeSalary Boolean @default(false) @map("employees_see_salary")

  /// Whether colleagues' absences show which kind of leave they are.
  showLeaveTypeToColleagues Boolean @default(false) @map("show_leave_type_to_colleagues")

  /// Whether an employee may correct their own contact details.
  employeesEditContact Boolean @default(true) @map("employees_edit_contact")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// Working time: shifts, schedules and the weekly rest day (M10 / HR-04).
//
// The site's working week (`SiteWorkWeek`) says what a site does. These say
// what a *person* does, which is not the same thing and is the reason the
// outlet can trade seven days while nobody works seven days.
//
// A schedule replaces the site's week **only where one is set**. An employee
// with no schedule of their own still follows their site, which is what makes
// this safe to introduce: nothing changes for anybody until somebody says it
// should.
// ---------------------------------------------------------------------------

/// One shift: when it starts, when it ends, and how long the break is.
model ShiftPattern {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  /// Local time, "07:00". Not an instant: a shift is a time of day.
  start String
  end   String

  breakMinutes    Int     @default(0) @map("break_minutes")
  /// True where the end is earlier than the start, as a night shift's is. The
  /// day a shift belongs to is the day it **started**.
  crossesMidnight Boolean @default(false) @map("crosses_midnight")

  note      String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  days             WorkScheduleDay[]
  schedules        EmployeeSchedule[] @relation("DefaultShift")
  shiftAssignments ShiftAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("shift_pattern")
}

/// A pattern of work across a week (HR-02 build spec §3.2).
model WorkSchedule {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  code        String
  name        String
  /// What a full week is worth, in hours. A demo value until SMG confirms it.
  weeklyHours Decimal @map("weekly_hours") @db.Decimal(5, 2)

  note      String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  days      WorkScheduleDay[]
  employees EmployeeSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_schedule")
}

/// One day of a schedule: whether it is worked, and on which shift.
model WorkScheduleDay {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid
  /// 0 is Sunday, 6 is Saturday — the same numbering as `SiteWorkWeek`.
  weekday    Int

  working        Boolean @default(true)
  shiftPatternId String? @map("shift_pattern_id") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schedule WorkSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shift    ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  @@unique([tenantId, scheduleId, weekday])
  @@index([tenantId])
  @@map("work_schedule_day")
}

/// Which schedule somebody is on, and which day of the week is their rest day.
///
/// Effective-dated, like every other parameter that changes (CLAUDE.md rule 3):
/// a rota that changes in March does not rewrite February.
model EmployeeSchedule {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid

  /// The one day a week this person does not work. 0 is Sunday. Null means the
  /// schedule alone decides, which is how an office week works.
  weeklyRestDay         Int?    @map("weekly_rest_day")
  /// Where this person's shift differs from the schedule's.
  defaultShiftPatternId String? @map("default_shift_pattern_id") @db.Uuid

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule     WorkSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  defaultShift ShiftPattern? @relation("DefaultShift", fields: [defaultShiftPatternId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, validFrom])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_schedule")
}

/// One day where somebody works a different shift from their usual one.
model ShiftAssignment {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  date           DateTime @db.Date
  shiftPatternId String   @map("shift_pattern_id") @db.Uuid

  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String   @map("created_by")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    ShiftPattern @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@map("shift_assignment")
}

// ---------------------------------------------------------------------------
// Attendance: where the punches come from (M10 / HR-04, build spec §5).
//
// A source is a device export or, later, a device API. Its **mapping** is the
// part that matters: every provider names its columns differently, and the
// answer to that is a setting rather than a release.
// ---------------------------------------------------------------------------

/// How punches arrive.
enum AttendanceSourceType {
  /// A file the device writes, uploaded by hand or dropped on a share.
  file
  /// The device maker's own interface. Not built: it waits on P09.
  api

  @@map("attendance_source_type")
}

enum AttendanceSourceStatus {
  active
  /// Shown on screen, switched off, with the reason — never a fake connection.
  planned

  @@map("attendance_source_status")
}

model AttendanceSource {
  id       String                 @id @default(uuid(7)) @db.Uuid
  tenantId String                 @map("tenant_id") @db.Uuid
  name     String
  type     AttendanceSourceType
  status   AttendanceSourceStatus @default(active)

  /// Which column of the file is which field, as
  /// `{ employeeNumber: "employee_number", timestamp: "timestamp", ... }`.
  /// A provider that names its columns differently is a setting, not a release.
  mapping Json

  /// The clock the device writes in. A punch at 06:58 is 06:58 *there*.
  timezone               String @default("Africa/Casablanca")
  /// Two punches by the same person inside this many seconds are one punch:
  /// somebody badging twice because the first beep was not heard.
  duplicateWindowSeconds Int    @default(120) @map("duplicate_window_seconds")

  /// Only for an API source, and only once there is one to describe.
  endpoint String?
  note     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attendanceImports AttendanceImport[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("attendance_source")
}

// ---------------------------------------------------------------------------
// Attendance: the punches, the days built from them, and what went wrong
// (M10 / HR-04, build spec §5.3 to §5.6).
//
// Two rules shape all of it, and both are the same rule the leave calculations
// follow:
//
//  - **a punch is evidence and is never edited.** A correction is a new punch
//    with a reason, so that "who changed this, and when" always has an answer.
//  - **a work day is derived and may be rebuilt.** It keeps the version of the
//    rules it was built with, so a day built last month can be explained even
//    after the overtime bands change.
// ---------------------------------------------------------------------------

enum PunchDirection {
  in
  out
  /// The device did not say. Punches are paired in order within the day.
  unknown

  @@map("punch_direction")
}

enum PunchSource {
  device
  manual

  @@map("punch_source")
}

enum AttendanceImportStatus {
  /// Read and checked; nothing written to anybody's days.
  previewed
  committed
  /// Superseded by a later import of the same period.
  replaced

  @@map("attendance_import_status")
}

enum WorkDayStatus {
  ok
  exception
  fixed
  approved

  @@map("work_day_status")
}

enum WorkDaySource {
  device
  manual
  /// Device punches with a manual correction on top.
  mixed

  @@map("work_day_source")
}

enum AttendanceExceptionStatus {
  open
  fixed
  ignored

  @@map("attendance_exception_status")
}

/// One upload, and what it contained.
model AttendanceImport {
  id       String                 @id @default(uuid(7)) @db.Uuid
  tenantId String                 @map("tenant_id") @db.Uuid
  sourceId String?                @map("source_id") @db.Uuid
  status   AttendanceImportStatus @default(previewed)

  /// Where the file itself is kept, so an argument about it can be settled.
  /// `fileKey` is for object storage; until that is wired the text sits in
  /// `content`, which is also what lets the confirmation re-read the file the
  /// trial checked instead of asking for it again.
  fileKey String? @map("file_key")

  /// The file, and a SHA-256 of it taken when it was read. Both are write-once:
  /// the runtime role has no UPDATE on either column, so the confirmation's
  /// hash check cannot be talked out of by the application that runs it.
  content       String? @db.Text
  contentSha256 String? @map("content_sha256")

  fileName String @map("file_name")

  /// The span the file covers, read from the punches in it.
  periodFrom DateTime? @map("period_from") @db.Date
  periodTo   DateTime? @map("period_to") @db.Date

  rows       Int @default(0)
  matched    Int @default(0)
  unknown    Int @default(0)
  duplicates Int @default(0)
  daysBuilt  Int @default(0) @map("days_built")
  exceptions Int @default(0)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt DateTime? @map("committed_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by")
  createdRole String    @map("created_role")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  source  AttendanceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  punches Punch[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("attendance_import")
}

/// One badge at a reader. Insert-only: a correction is another punch.
model Punch {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  importId String? @map("import_id") @db.Uuid

  /// As the device wrote it, before anybody matched it to a person.
  employeeNumber String  @map("employee_number")
  employeeId     String? @map("employee_id") @db.Uuid

  at        DateTime       @db.Timestamptz(3)
  direction PunchDirection @default(unknown)
  deviceId  String?        @map("device_id")
  source    PunchSource    @default(device)

  /// Why, for a punch somebody added by hand. Required of a manual one.
  reason    String?
  /// True where this punch was dropped as a repeat inside the window.
  duplicate Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  import   AttendanceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  employee Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId, at])
  @@index([tenantId, importId])
  @@map("punch")
}

/// A number the device writes that is really somebody we know.
///
/// "0107" is the case that matters: a device padding its numbers is not a
/// different person, and saying so once should be enough.
model EmployeeNumberAlias {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  alias      String
  employeeId String @map("employee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String   @map("created_by")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, alias])
  @@index([tenantId])
  @@map("employee_number_alias")
}

/// One person, one day, built from the punches (build spec §5.3).
model WorkDay {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date

  scheduledMin  Int @default(0) @map("scheduled_min")
  workedMin     Int @default(0) @map("worked_min")
  breakMin      Int @default(0) @map("break_min")
  lateMin       Int @default(0) @map("late_min")
  earlyLeaveMin Int @default(0) @map("early_leave_min")

  /// Minutes per overtime band, as `{ "OT_DAY": 120, "OT_NIGHT": 60 }`.
  overtime Json

  status WorkDayStatus @default(ok)
  source WorkDaySource @default(device)

  /// The leave request that explains the absence, where there is one.
  leaveRequestId String? @map("leave_request_id") @db.Uuid

  /// The rule rows this day was built with, so it can be explained after they
  /// change — the same promise `LeaveCalculation` makes.
  calcVersion String   @map("calc_version")
  builtAt     DateTime @default(now()) @map("built_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  exceptions AttendanceException[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("work_day")
}

/// Something about a day that a person has to look at.
model AttendanceException {
  id        String                    @id @default(uuid(7)) @db.Uuid
  tenantId  String                    @map("tenant_id") @db.Uuid
  workDayId String?                   @map("work_day_id") @db.Uuid
  punchId   String?                   @map("punch_id") @db.Uuid
  /// UNKNOWN_EMPLOYEE, MISSING_IN, MISSING_OUT, DUPLICATE, NO_SCHEDULE,
  /// ABSENT_NO_LEAVE, WORKED_ON_LEAVE, WORKED_REST_DAY, WORKED_HOLIDAY,
  /// OVER_DAILY_MAX, OVER_WEEKLY_MAX.
  code      String
  status    AttendanceExceptionStatus @default(open)

  /// What the exception is about, where it is not about a day: the number a
  /// device wrote that matches nobody, for instance.
  detail String?

  resolution String?
  comment    String?
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workDay WorkDay? @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status, code])
  @@map("attendance_exception")
}

/// What an hour of overtime is worth, from a date (build spec §5.6).
///
/// Effective-dated rows like every other parameter (CLAUDE.md rule 3): changing
/// a rate writes a new row, and days already built keep the version they used
/// until somebody rebuilds them.
model OvertimeRule {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bandCode String @map("band_code")
  /// working, rest or holiday.
  dayType  String @map("day_type")

  /// Local times. A band whose end is before its start runs through midnight.
  timeFrom String @map("time_from")
  timeTo   String @map("time_to")

  ratePercent Decimal @map("rate_percent") @db.Decimal(6, 2)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  note      String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, effectiveFrom])
  @@map("overtime_rule")
}

/// The company-wide decisions about working time.
model OvertimeSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// daily, weekly or both. "Both, without counting the same hour twice" is
  /// the default, and it is a question for SMG.
  thresholdMode     String  @default("both") @map("threshold_mode")
  normalWeeklyHours Decimal @default(44) @map("normal_weekly_hours") @db.Decimal(5, 2)
  normalDailyHours  Decimal @default(8) @map("normal_daily_hours") @db.Decimal(5, 2)

  roundingMinutes   Int    @default(15) @map("rounding_minutes")
  /// up, down or nearest. "Up" is in the employee's favour.
  roundingDirection String @default("up") @map("rounding_direction")

  latenessToleranceMin Int     @default(10) @map("lateness_tolerance_min")
  dailyMaxHours        Decimal @default(12) @map("daily_max_hours") @db.Decimal(5, 2)

  note      String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("overtime_settings")
}
