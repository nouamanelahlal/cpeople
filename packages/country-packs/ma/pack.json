    "schema": [
      {
        "id": "base_salary",
        "kind": "line",
        "wageType": "1000",
        "amount": "input('MONTHLY_SALARY') * input('DAYS_PAID') / param('PAYROLL_DAYS')",
        "base": "input('MONTHLY_SALARY')",
        "quantity": "input('DAYS_PAID')",
        "note": "Spec §12 step 1; proration on 26 days (CP-PAY-040), to validate."
      },
      {
        "id": "seniority",
        "kind": "line",
        "wageType": "1100",
        "when": "band('SENIORITY_RATES', input('SERVICE_YEARS')) > 0",
        "amount": "base('SENIORITY_BASE') * band('SENIORITY_RATES', input('SERVICE_YEARS'))",
        "base": "base('SENIORITY_BASE')",
        "rate": "band('SENIORITY_RATES', input('SERVICE_YEARS'))",
        "note": "Spec §12 step 2. Seniority base = base salary only: open point O16."
      },
      {
        "id": "overtime_1",
        "kind": "line",
        "wageType": "1200",
        "when": "input('OT_DAY_HOURS') > 0",
        "amount": "input('MONTHLY_SALARY') * (1 + band('SENIORITY_RATES', input('SERVICE_YEARS'))) / param('PAYROLL_HOURS') * (1 + input('OT_DAY_PREMIUM')) * input('OT_DAY_HOURS')",
        "quantity": "input('OT_DAY_HOURS')",
        "rate": "input('OT_DAY_PREMIUM')",
        "note": "Hourly rate = (salary + seniority) ÷ 191 (OT03); the premium comes from the tenant's overtime rule. Base: open point O16."
      },
      {
        "id": "overtime_2",
        "kind": "line",
        "wageType": "1210",
        "when": "input('OT_NIGHT_HOURS') > 0",
        "amount": "input('MONTHLY_SALARY') * (1 + band('SENIORITY_RATES', input('SERVICE_YEARS'))) / param('PAYROLL_HOURS') * (1 + input('OT_NIGHT_PREMIUM')) * input('OT_NIGHT_HOURS')",
        "quantity": "input('OT_NIGHT_HOURS')",
        "rate": "input('OT_NIGHT_PREMIUM')",
        "note": "As above."
      },
      {
        "id": "overtime_3",
        "kind": "line",
        "wageType": "1220",
        "when": "input('OT_REST_DAY_HOURS') > 0",
        "amount": "input('MONTHLY_SALARY') * (1 + band('SENIORITY_RATES', input('SERVICE_YEARS'))) / param('PAYROLL_HOURS') * (1 + input('OT_REST_DAY_PREMIUM')) * input('OT_REST_DAY_HOURS')",
        "quantity": "input('OT_REST_DAY_HOURS')",
        "rate": "input('OT_REST_DAY_PREMIUM')",
        "note": "As above."
      },
      {
        "id": "overtime_4",
        "kind": "line",
        "wageType": "1230",
        "when": "input('OT_REST_NIGHT_HOURS') > 0",
        "amount": "input('MONTHLY_SALARY') * (1 + band('SENIORITY_RATES', input('SERVICE_YEARS'))) / param('PAYROLL_HOURS') * (1 + input('OT_REST_NIGHT_PREMIUM')) * input('OT_REST_NIGHT_HOURS')",
        "quantity": "input('OT_REST_NIGHT_HOURS')",
        "rate": "input('OT_REST_NIGHT_PREMIUM')",
        "note": "As above."
      },
      {
        "id": "night_premium_1",
        "kind": "line",
        "wageType": "1240",
        "when": "input('NIGHT_PREMIUM_HOURS') > 0",
        "amount": "input('MONTHLY_SALARY') * (1 + band('SENIORITY_RATES', input('SERVICE_YEARS'))) / param('PAYROLL_HOURS') * input('NIGHT_PREMIUM_RATE') * input('NIGHT_PREMIUM_HOURS')",
        "quantity": "input('NIGHT_PREMIUM_HOURS')",
        "rate": "input('NIGHT_PREMIUM_RATE')",
        "note": "Scheduled hours inside a premium band (an `all_hours` overtime rule). The hours are already in the monthly salary, so only the premium is paid here — the rate is not 1 + rate. Whether SMG owes such a premium at all is HR-02 open point 17; the rate comes from the tenant's rule, never from this pack."
      },
      {
        "id": "taxable_variables",
        "kind": "variables",
        "treatmentClasses": [
          "MA_TAXABLE"
        ],
        "note": "Company earnings (commission, weekend premium, bonuses). Exempt allowances (transport, meal) wait for their ceilings: open point O17."
      },
      {
        "id": "cnss_employee",
        "kind": "line",
        "wageType": "5100",
        "amount": "min(base('SOCIAL'), param('CNSS_CEILING')) * param('CNSS_EE_RATE')",
        "base": "min(base('SOCIAL'), param('CNSS_CEILING'))",
        "rate": "param('CNSS_EE_RATE')"
      },
      {
        "id": "amo_employee",
        "kind": "line",
        "wageType": "5110",
        "amount": "base('SOCIAL') * param('AMO_EE_RATE')",
        "base": "base('SOCIAL')",
        "rate": "param('AMO_EE_RATE')"
      },
      {
        "id": "cimr_employee",
        "kind": "line",
        "wageType": "5120",
        "when": "input('CIMR_EE_RATE') > 0",
        "amount": "base('SOCIAL') * input('CIMR_EE_RATE')",
        "base": "base('SOCIAL')",
        "rate": "input('CIMR_EE_RATE')",
        "note": "Inactive for SMG (CT05). CIMR base and tax deductibility to validate."
      },
      {
        "id": "professional_expenses",
        "kind": "line",
        "wageType": "9010",
        "amount": "if(base('TAXABLE') * 12 <= param('PROF_EXP_THRESHOLD_ANNUAL'), base('TAXABLE') * param('PROF_EXP_RATE_LOW'), min(base('TAXABLE') * param('PROF_EXP_RATE_HIGH'), param('PROF_EXP_CAP_ANNUAL') / 12))",
        "base": "base('TAXABLE')",
        "note": "Spec §12 step 12; open point O15."
      },
      {
        "id": "net_taxable",
        "kind": "line",
        "wageType": "9020",
        "amount": "max(base('TAXABLE') - base('TAX_DEDUCTIBLE'), 0)",
        "keepZero": true
      },
      {
        "id": "income_tax_gross",
        "kind": "line",
        "wageType": "9030",
        "amount": "bracket('IR_ANNUAL', wt('9020') * 12) / 12",
        "base": "wt('9020')",
        "keepZero": true,
        "note": "The annual scale applied to the annualised monthly income, ÷ 12. The method (annualised vs a monthly table with rounded deductions) is to validate: they can differ by 0.01."
      },
      {
        "id": "family_deduction",
        "kind": "line",
        "wageType": "9040",
        "amount": "min(wt('9030'), min(input('TAX_DEPENDENTS'), param('FAMILY_MAX_DEPENDENTS')) * param('FAMILY_DEDUCTION_ANNUAL') / 12)",
        "quantity": "min(input('TAX_DEPENDENTS'), param('FAMILY_MAX_DEPENDENTS'))"
      },
      {
        "id": "income_tax",
        "kind": "line",
        "wageType": "5200",
        "amount": "wt('9030') - wt('9040')",
        "base": "wt('9020')",
        "keepZero": true
      },
      {
        "id": "other_variables",
        "kind": "variables",
        "treatmentClasses": [
          "MA_DEDUCTION",
          "MA_REIMBURSEMENT"
        ]
      },
      {
        "id": "net_pay",
        "kind": "line",
        "wageType": "9900",
        "amount": "base('GROSS') - base('EE_DEDUCTIONS') + base('REIMBURSEMENTS')",
        "keepZero": true
      },
      {
        "id": "cnss_employer",
        "kind": "line",
        "wageType": "7100",
        "amount": "min(base('SOCIAL'), param('CNSS_CEILING')) * param('CNSS_ER_RATE')",
        "base": "min(base('SOCIAL'), param('CNSS_CEILING'))",
        "rate": "param('CNSS_ER_RATE')"
      },
      {
        "id": "family_allowances",
        "kind": "line",
        "wageType": "7110",
        "amount": "base('SOCIAL') * param('AF_ER_RATE')",
        "base": "base('SOCIAL')",
        "rate": "param('AF_ER_RATE')"
      },
      {
        "id": "amo_employer",
        "kind": "line",
        "wageType": "7120",
        "amount": "base('SOCIAL') * param('AMO_ER_RATE')",
        "base": "base('SOCIAL')",
        "rate": "param('AMO_ER_RATE')"
      },
      {
        "id": "training_tax",
        "kind": "line",
        "wageType": "7130",
        "amount": "base('SOCIAL') * param('TFP_ER_RATE')",
        "base": "base('SOCIAL')",
        "rate": "param('TFP_ER_RATE')"
      },
      {
        "id": "cimr_employer",
        "kind": "line",
        "wageType": "7140",
        "when": "input('CIMR_ER_RATE') > 0",
        "amount": "base('SOCIAL') * input('CIMR_ER_RATE')",
        "base": "base('SOCIAL')",
        "rate": "input('CIMR_ER_RATE')"
      }
    ],
    "checks": [
      {
        "id": "BELOW_MINIMUM_WAGE",
        "level": "block",
        "when": "input('MONTHLY_SALARY') < param('SMIG_HOURLY') * param('PAYROLL_HOURS')",
        "message": {
          "en": "Base salary is below the minimum wage for a full-time month.",
          "fr": "Le salaire de base est inférieur au SMIG d'un mois à temps plein."
        }
      },
      {
        "id": "DAYS_ABOVE_MONTH",
        "level": "block",
        "when": "input('DAYS_PAID') > param('PAYROLL_DAYS')",
        "message": {
          "en": "More days paid than a payroll month holds.",
          "fr": "Plus de jours payés qu'un mois de paie n'en compte."
        }
      },
      {
        "id": "DEPENDENTS_CAPPED",
        "level": "info",
        "when": "input('TAX_DEPENDENTS') > param('FAMILY_MAX_DEPENDENTS')",
        "message": {
          "en": "Only the legal maximum of dependents is counted for income tax.",
          "fr": "Seul le maximum légal de personnes à charge est retenu pour l'IR."
        }
      }
    ]
  }
}
