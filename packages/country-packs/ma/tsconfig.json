{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Node's own ESM resolution, like @cpeople/shared: every relative import
    // carries a .js specifier. Node types for the hash and the pack CLI.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
