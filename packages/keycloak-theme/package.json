{
  "name": "@cpeople/keycloak-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CPeople sign-in theme for Keycloak, built with Keycloakify (M02 / HR-08)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build:theme": "tsc -b && vite build && keycloakify build"
  },
  "dependencies": {
    "@cpeople/ui": "workspace:*",
    "keycloakify": "^11.16.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
